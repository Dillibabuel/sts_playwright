# Copy this file to .env and fill your own values.

# Credentials used by all environments.
STS_USERNAME=your-username
STS_PASSWORD=your-password

# Environment URLs.
STS_LOCAL_URL=http://localhost/sts/
STS_DEV_URL=https://dev.example.com/sts/
STS_PROD_URL=https://prod.example.com/sts/

# Optional hard override. If set, this URL is used regardless of STS_ENV.
# STS_BASE_URL=https://any-target.example.com/sts/
